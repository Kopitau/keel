{
  "_comment": "Copy to keel/config.json and edit. Gate ignores keys starting with _.",
  "schema_version": 1,
  "project_name": "example",
  "records_dir": "keel",
  "enforcement_tier": "local",
  "keel_version": "0.0.0",
  "profiles": {
    "_comment": "DEC-188: test_command = launcher prefix (python -m / uv run python -m / uv run / poetry run / npx / pnpm exec / pnpm / yarn / node) + program (pytest / vitest run / jest / node --test) + marker or report arguments (-q -x -m <marker> --tb= --maxfail= --reporter --junitxml=). No -k, no paths, no name patterns (ISS-018). gate verify adds the junit output itself.",
    "active": "unset",
    "keel-gate": {
      "language": "typescript",
      "runtime": "node",
      "node_min": "22.18.0",
      "test_command": "node --test",
      "typecheck": "tsc --noEmit"
    },
    "python-cli": {
      "language": "python",
      "test_command": "python -m pytest -q",
      "_example_uv": "uv run python -m pytest -q -m unit",
      "core_marker": "core"
    },
    "ts-js": {
      "language": "typescript",
      "test_command": "npx vitest run",
      "_example_pnpm": "pnpm exec vitest run"
    }
  },
  "identities": {
    "humans": [
      {
        "name": "YOUR-NAME",
        "email": "you@example.com"
      }
    ],
    "agents": [
      {
        "name": "keel-agent",
        "email": "agent@keel.local"
      }
    ]
  },
  "platforms": {
    "primary": [
      "claude-code",
      "codex",
      "opencode",
      "grok-build",
      "deepseek-harness"
    ],
    "compatible": [
      "pi",
      "cursor"
    ],
    "os_matrix": [
      "windows",
      "macos",
      "linux"
    ],
    "development": [
      "windows",
      "macos"
    ],
    "ci": [
      "linux"
    ]
  },
  "optional": {
    "no_mistakes": false,
    "recorder_medium_for_longform": true
  }
}
