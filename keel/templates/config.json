{
  "_comment": "Copy to keel/config.json and edit. Gate ignores keys starting with _.",
  "schema_version": 1,
  "project_name": "example",
  "records_dir": "keel",
  "enforcement_tier": "local",
  "keel_version": "0.0.0",
  "profiles": {
    "active": "unset",
    "keel-gate": {
      "language": "typescript",
      "runtime": "node",
      "node_min": "22.18.0",
      "test_command": "node --test",
      "typecheck": "tsc --noEmit"
    },
    "python-cli": {
      "language": "python",
      "test_command": "python -m pytest -q",
      "core_marker": "core"
    }
  },
  "identities": {
    "humans": [
      {
        "name": "YOUR-NAME",
        "email": "you@example.com"
      }
    ],
    "agents": [
      {
        "name": "keel-agent",
        "email": "agent@keel.local"
      }
    ]
  },
  "platforms": {
    "primary": [
      "claude-code",
      "codex",
      "opencode",
      "grok-build",
      "deepseek-harness"
    ],
    "compatible": [
      "pi"
    ],
    "os_matrix": [
      "windows",
      "macos",
      "linux"
    ],
    "development": [
      "windows",
      "macos"
    ],
    "ci": [
      "linux"
    ],
    "deepseek_harness_windows": "WSL required for its Python SDK/PTY (C-96). Files are readable on Windows. macOS: dsh fully available (CHG-001)."
  },
  "optional": {
    "no_mistakes": false,
    "heterogeneous_review": false,
    "recorder_medium_for_longform": true
  }
}
