#!/bin/sh
# CHG-011 (DEC-183): the pre-commit hook is a seconds-long fence, not the test suite.
# It runs the quick gate (G-req, G-plan, X-trace, X-bypass) and, when an approval
# file is staged, the DEC-166/167 identity guard. Full tests and typecheck live in
# `gate verify` and CI (C-100: CI is the authority).
root=$(git rev-parse --show-toplevel) || exit 1
"$root/tools/gate/gate.sh" check --quick || exit 1
if git diff --cached --name-only | grep -qE '(^|/)keel/approvals/'; then
  "$root/tools/gate/gate.sh" hook pre-commit-apr || exit 1
fi
exec "$root/tools/gate/gate.sh" hook pre-commit-stamp
