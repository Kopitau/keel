#!/bin/sh
root=$(git rev-parse --show-toplevel) || exit 1
# C-105: force-push is reminder-level (does not block). Then verify + check still run.
"$root/tools/gate/gate.sh" hook pre-push || true
# ISS-079: reuse fresh, green, tree-bound evidence; rerun the suite only when it is stale.
"$root/tools/gate/gate.sh" hook verify-if-stale || exit 1
exec "$root/tools/gate/gate.sh" check
